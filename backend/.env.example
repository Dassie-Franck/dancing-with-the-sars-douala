# Origines autorisées (CORS), séparées par des virgules. Ajoutez l'URL Vercel du front. Jamais « * ».
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# development (défaut) ou production : en production, /docs est masqué, HSTS est activé
# et l'API refuse de démarrer si ALLOWED_ORIGINS contient « * ».
APP_ENV=development
# Requêtes autorisées par minute et par adresse IP (0 = pas de limite)
RATE_LIMIT_PER_MINUTE=240
# Dossier contenant manifest.json (facultatif : par défaut app/data puis ../frontend/public/data)
# DATA_DIR=
