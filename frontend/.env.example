# Copier en ".env.local" pour changer la source des données du frontend (aucun code à modifier).
# Voir ARCHITECTURE.md.

# static (défaut) : lit public/data/manifest.json (données factices aujourd'hui, sortie du notebook demain)
# api            : lit l'API FastAPI ; si elle ne répond pas en 3 s, repli automatique sur les fichiers statiques
VITE_DATA_SOURCE=static

# Adresse de l'API (utilisée seulement si VITE_DATA_SOURCE=api)
VITE_API_URL=http://localhost:8000

# Où sont servis les PNG des couches (optionnel). Vide = public/data/ du frontend.
# Exemple si l'API les expose avec StaticFiles (tâche K8) : http://localhost:8000/static/
VITE_LAYERS_URL=
